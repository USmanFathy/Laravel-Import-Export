{
    "name": "usman-ahmed/laravel-import-export",
    "description": "Enterprise-grade metadata-driven Laravel imports, exports, and spreadsheet templates.",
    "keywords": [
        "laravel",
        "imports",
        "queues",
        "xlsx",
        "csv",
        "bulk"
    ],
    "license": "proprietary",
    "type": "library",
    "require": {
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "illuminate/auth": "^12.0",
        "illuminate/bus": "^12.0",
        "illuminate/cache": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "openspout/openspout": "^4.28",
        "php": "^8.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "UsmanAhmed\\ImportExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UsmanAhmed\\ImportExport\\Tests\\": "tests/",
            "UsmanAhmed\\ImportExport\\Examples\\": "examples/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UsmanAhmed\\ImportExport\\ImportExportServiceProvider"
            ],
            "aliases": {
                "BulkImport": "UsmanAhmed\\ImportExport\\Facades\\BulkImport",
                "ImportExport": "UsmanAhmed\\ImportExport\\Facades\\ImportExport"
            }
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group performance",
        "test:large": "phpunit --group performance",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Usman Ahmed",
            "role": "Developer"
        }
    ]
}
